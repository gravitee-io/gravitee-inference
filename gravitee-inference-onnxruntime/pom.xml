<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>gravitee-inference</artifactId>
    <groupId>io.gravitee.inference</groupId>
    <version>3.0.0</version>
  </parent>

  <groupId>io.gravitee.inference.onnxruntime</groupId>
  <artifactId>gravitee-inference-onnxruntime</artifactId>

  <name>Gravitee.io Inference - ONNX Runtime</name>
  <description>ONNX Runtime Java API repackaged without native libraries, which are published as one jar per platform classifier</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
      <comments>Repackaged from com.microsoft.onnxruntime:onnxruntime, Copyright (c) Microsoft Corporation</comments>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <onnxruntime.version>1.22.0</onnxruntime.version>
    <onnxruntime.unpack.directory>${project.build.directory}/onnxruntime-unpacked</onnxruntime.unpack.directory>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-onnxruntime</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.microsoft.onnxruntime</groupId>
                  <artifactId>onnxruntime</artifactId>
                  <version>${onnxruntime.version}</version>
                  <outputDirectory>${onnxruntime.unpack.directory}</outputDirectory>
                  <!-- Debug symbols and SBOM are not repackaged; skipping them also avoids unpacking ~500 MB -->
                  <excludes>_manifest/**,**/*.dSYM/**,**/*.pdb</excludes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-onnxruntime-license</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${onnxruntime.unpack.directory}/META-INF</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/legal</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>default-jar</id>
            <configuration>
              <classesDirectory>${onnxruntime.unpack.directory}</classesDirectory>
              <excludes>
                <exclude>ai/onnxruntime/native/**</exclude>
              </excludes>
            </configuration>
          </execution>
        <execution>
          <id>natives-linux-x64</id>
          <phase>package</phase>
          <goals>
            <goal>jar</goal>
          </goals>
          <configuration>
            <classifier>linux-x64</classifier>
            <classesDirectory>${onnxruntime.unpack.directory}</classesDirectory>
            <includes>
              <include>ai/onnxruntime/native/linux-x64/**</include>
              <include>META-INF/LICENSE</include>
              <include>ThirdPartyNotices.txt</include>
            </includes>
            <excludes>
              <exclude>**/*.dSYM/**</exclude>
              <exclude>**/*.pdb</exclude>
            </excludes>
          </configuration>
        </execution>
        <execution>
          <id>natives-linux-aarch64</id>
          <phase>package</phase>
          <goals>
            <goal>jar</goal>
          </goals>
          <configuration>
            <classifier>linux-aarch64</classifier>
            <classesDirectory>${onnxruntime.unpack.directory}</classesDirectory>
            <includes>
              <include>ai/onnxruntime/native/linux-aarch64/**</include>
              <include>META-INF/LICENSE</include>
              <include>ThirdPartyNotices.txt</include>
            </includes>
            <excludes>
              <exclude>**/*.dSYM/**</exclude>
              <exclude>**/*.pdb</exclude>
            </excludes>
          </configuration>
        </execution>
        <execution>
          <id>natives-osx-aarch64</id>
          <phase>package</phase>
          <goals>
            <goal>jar</goal>
          </goals>
          <configuration>
            <classifier>osx-aarch64</classifier>
            <classesDirectory>${onnxruntime.unpack.directory}</classesDirectory>
            <includes>
              <include>ai/onnxruntime/native/osx-aarch64/**</include>
              <include>META-INF/LICENSE</include>
              <include>ThirdPartyNotices.txt</include>
            </includes>
            <excludes>
              <exclude>**/*.dSYM/**</exclude>
              <exclude>**/*.pdb</exclude>
            </excludes>
          </configuration>
        </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
